# Volcano Engine MLP + PI-DEX joint_29d defaults (Insert_Battery / 1×8 GPU).
# Copy into the job env, or `set -a; source this file; set +a` before start.
#
# Platform still injects on each worker:
#   MLP_WORKER_NUM MLP_WORKER_GPU MLP_ROLE_INDEX MLP_WORKER_0_HOST MLP_WORKER_0_PORT
#
# MLP 自定义启动命令（推荐，脚本内会 conda activate + 填训练参数）:
#   export WANDB_API_KEY=...
#   bash /mnt/netdata/Team/Personal/congsheng/PI-DEX/scripts/volc_ddp_train.sh
#
# 单节点 8 卡时平台侧配置示例（其余由平台注入）:
#   MLP_WORKER_NUM=1
#   MLP_WORKER_GPU=8
#
# 两节点 8 卡:
#   MLP_WORKER_NUM=2
#   MLP_WORKER_GPU=8

# --- site paths ---
PI_DEX_REPO=/mnt/netdata/Team/Personal/congsheng/PI-DEX
PI_DEX_ARTIFACTS=/mnt/netdata/Team/Personal/congsheng/pi-dex-artifacts
CONDA_ROOT=/mnt/netdata/Team/Personal/congsheng/miniconda
PI_DEX_CONDA_ENV=pi-dex
OPENPI_DATA_HOME=/mnt/netdata/Team/Personal/congsheng/pi-dex-artifacts/openpi-data

CONTRACT=/mnt/netdata/Team/Personal/congsheng/PI-DEX/configs/site/joint_29d_observation.reviewed.json
CONVERTED_BASE=/mnt/netdata/Team/Personal/congsheng/pi-dex-artifacts/converted/pi05_base-pytorch-bfloat16-K8
EXPECTED_BASE_SHA256=2f8539e2308611ea6fff84a5d7774f80d7c177c624769ff842008cf85dea9eeb

# --- Insert_Battery prepared overlay ---
DATASET_ROOT=/mnt/netdata/Team/Personal/congsheng/pi-dex-artifacts/prepared/Insert_Battery
ASSETS_DIR=/mnt/netdata/Team/Personal/congsheng/pi-dex-artifacts/assets-Insert_Battery
ASSET_ID=sharpa_joint_29d_insert_battery
ROBOT_ID=POC22005

# --- train hyperparams ---
MAX_STEPS=1000
BATCH_SIZE=1
LEARNING_RATE=1e-5
SEED=0
DEVICE=cuda
DTYPE=bfloat16
SPLIT=train
SAVE_INTERVAL=500
LOG_INTERVAL=10

# --- wandb (API key must be set in the job secret/env; do not commit the key) ---
VOLC_WANDB=1
WANDB_PROJECT=pi-dex
# WANDB_API_KEY=
# WANDB_ENTITY=
# WANDB_RUN_NAME=

# --- local dry-run MLP stubs (platform overrides these in real jobs) ---
MLP_WORKER_NUM=1
MLP_WORKER_GPU=8
MLP_ROLE_INDEX=0
MLP_WORKER_0_HOST=127.0.0.1
MLP_WORKER_0_PORT=29500
