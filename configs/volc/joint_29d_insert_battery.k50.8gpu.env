# Volcano Engine MLP + PI-DEX joint_29d (Insert_Battery / 1×8 GPU, K=50).
# Predicts 50 physical bimanual steps (~0.84 s @ 59.4 Hz); model action_horizon=100.
# Converted pi05_base is reused from K8 (weights are action_dim=32, horizon-agnostic).
# Copy into the job env, or `set -a; source this file; set +a` before start.
#
# Platform still injects on each worker:
#   MLP_WORKER_NUM MLP_WORKER_GPU MLP_ROLE_INDEX MLP_WORKER_0_HOST MLP_WORKER_0_PORT
#
# MLP 自定义启动命令:
#   export WANDB_API_KEY=...
#   set -a; source /mnt/netdata/Team/Personal/congsheng/PI-DEX/configs/volc/joint_29d_insert_battery.k50.8gpu.env; set +a
#   bash /mnt/netdata/Team/Personal/congsheng/PI-DEX/scripts/volc_ddp_train.sh
#
# 单节点 8 卡:
#   MLP_WORKER_NUM=1
#   MLP_WORKER_GPU=8
#
# 数据源（只读 Academic）:
#   /mnt/netdata/Team/Academic/Data/Foundation_Model/Insert_Battery
# 训练用 overlay:
#   ${PI_DEX_ARTIFACTS}/prepared/Insert_Battery

# --- site paths ---
PI_DEX_REPO=/mnt/netdata/Team/Personal/congsheng/PI-DEX
PI_DEX_ARTIFACTS=/mnt/netdata/Team/Personal/congsheng/pi-dex-artifacts
CONDA_ROOT=/mnt/netdata/Team/Personal/congsheng/miniconda
PI_DEX_CONDA_ENV=pi-dex
OPENPI_DATA_HOME=/mnt/netdata/Team/Personal/congsheng/pi-dex-artifacts/openpi-data

CONTRACT=/mnt/netdata/Team/Personal/congsheng/PI-DEX/configs/site/joint_29d_observation.k50.reviewed.json
CONVERTED_BASE=/mnt/netdata/Team/Personal/congsheng/pi-dex-artifacts/converted/pi05_base-pytorch-bfloat16-K8
EXPECTED_BASE_SHA256=2f8539e2308611ea6fff84a5d7774f80d7c177c624769ff842008cf85dea9eeb

# --- Insert_Battery prepared overlay ---
DATASET_ROOT=/mnt/netdata/Team/Personal/congsheng/pi-dex-artifacts/prepared/Insert_Battery
ASSETS_DIR=/mnt/netdata/Team/Personal/congsheng/pi-dex-artifacts/assets-Insert_Battery
ASSET_ID=sharpa_joint_29d_insert_battery_k50
ROBOT_ID=POC22005

# --- train hyperparams ---
MAX_STEPS=80000
BATCH_SIZE=16
LEARNING_RATE=1e-5
# OpenPI-style cosine: linear warmup to peak, then cosine to LR_END over LR_DECAY_STEPS.
LR_WARMUP_STEPS=1000
LR_DECAY_STEPS=80000
LR_END=1e-6
SEED=0
DEVICE=cuda
DTYPE=bfloat16
SPLIT=train
SAVE_INTERVAL=5000
LOG_INTERVAL=10

# --- wandb (API key must be set in the job secret/env; do not commit the key) ---
VOLC_WANDB=1
WANDB_PROJECT=pi-dex
# WANDB_API_KEY=
# WANDB_ENTITY=
# WANDB_RUN_NAME=

# --- local dry-run MLP stubs ---
# Do NOT set MLP_* here: `set -a; source` would overwrite Volcano's injected
# MLP_WORKER_0_HOST. For a local dry-run, export them yourself:
#   MLP_WORKER_NUM=1 MLP_WORKER_GPU=8 MLP_ROLE_INDEX=0
#   MLP_WORKER_0_HOST=127.0.0.1 MLP_WORKER_0_PORT=29500
