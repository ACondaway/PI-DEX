# Volcano Engine MLP + PI-DEX joint_29d (Close_Bottle_Cap_v2 / 1×8 GPU, K=50, scheme-A delta).
# Training target: delta[k] = absolute_cmd[k] - state(t0).
# Deployment must use --action-mode delta (robot bridge composes absolute before publish).
#
# MLP 自定义启动命令:
#   export WANDB_API_KEY=...
#   set -a; source /mnt/netdata/Team/Personal/congsheng/PI-DEX/configs/volc/joint_29d_close_bottle_cap_v2.k50.delta.8gpu.env; set +a
#   bash /mnt/netdata/Team/Personal/congsheng/PI-DEX/scripts/volc_ddp_train.sh
#
# Norm (single CPU process, before train):
#   set -a; source .../joint_29d_close_bottle_cap_v2.k50.delta.8gpu.env; set +a
#   VOLC_SKIP_MLP=1 bash .../scripts/volc_compute_norm.sh
#
# 数据源（只读 Academic）:
#   /mnt/netdata/Team/Academic/Data/Foundation_Model/Close_Bottle_Cap_v2
# 训练用 overlay:
#   ${PI_DEX_ARTIFACTS}/prepared/Close_Bottle_Cap_v2

# --- site paths ---
PI_DEX_REPO=/mnt/netdata/Team/Personal/congsheng/PI-DEX
PI_DEX_ARTIFACTS=/mnt/netdata/Team/Personal/congsheng/pi-dex-artifacts
CONDA_ROOT=/mnt/netdata/Team/Personal/congsheng/miniconda
PI_DEX_CONDA_ENV=pi-dex
OPENPI_DATA_HOME=/mnt/netdata/Team/Personal/congsheng/pi-dex-artifacts/openpi-data

CONTRACT=/mnt/netdata/Team/Personal/congsheng/PI-DEX/configs/site/joint_29d_observation.k50.reviewed.json
CONVERTED_BASE=/mnt/netdata/Team/Personal/congsheng/pi-dex-artifacts/converted/pi05_base-pytorch-bfloat16-K8
EXPECTED_BASE_SHA256=2f8539e2308611ea6fff84a5d7774f80d7c177c624769ff842008cf85dea9eeb

# --- Close_Bottle_Cap_v2 prepared overlay ---
DATASET_ROOT=/mnt/netdata/Team/Personal/congsheng/pi-dex-artifacts/prepared/Close_Bottle_Cap_v2
ASSETS_DIR=/mnt/netdata/Team/Personal/congsheng/pi-dex-artifacts/assets-Close_Bottle_Cap_v2
ASSET_ID=sharpa_joint_29d_close_bottle_cap_v2_k50_delta
ROBOT_ID=POC22017

# --- action semantics (HDF5 commands remain absolute; labels are delta) ---
ACTION_MODE=delta
COMMAND_SEMANTICS_VERSION=sharpa_sdk_commanded_joint_position_absolute_v1

# --- train hyperparams ---
MAX_STEPS=80000
BATCH_SIZE=16
LEARNING_RATE=1e-5
LR_WARMUP_STEPS=1000
LR_DECAY_STEPS=80000
LR_END=1e-6
SEED=0
DEVICE=cuda
DTYPE=bfloat16
SPLIT=train
SAVE_INTERVAL=5000
LOG_INTERVAL=10

# --- wandb ---
VOLC_WANDB=1
WANDB_PROJECT=pi-dex

# Norm job output (volc_compute_norm.sh)
OUTPUT_JSON=${PI_DEX_ARTIFACTS}/dataset/Close_Bottle_Cap_v2_k50_delta_norm.json
