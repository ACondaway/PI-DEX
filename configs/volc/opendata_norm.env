# Volcano Engine MLP + PI-DEX compute-norm-stats (full SharpaOpenData).
#
# 这是单进程 Python 任务（进程内多 CPU worker 扫 HDF5），不需要多卡。平台侧建议：
#   MLP_WORKER_NUM=1
#   MLP_WORKER_GPU=1
# 选高核 CPU 机器；可设 NORM_WORKERS（默认 min(核数, 64)）。
# BLAS 线程由脚本默认打到 1，避免和 worker 抢核。
#
# MLP 自定义启动命令:
#   bash /mnt/netdata/Team/Personal/congsheng/PI-DEX/scripts/volc_compute_norm.sh
#
# 产物:
#   ${ASSETS_DIR}/${ASSET_ID}/norm_stats.json
#   ${PI_DEX_ARTIFACTS}/dataset/norm_opendata_full.json
#
# 若目标已存在，默认拒绝覆盖；覆盖时加 NORM_FORCE=1。

# --- site paths ---
PI_DEX_REPO=/mnt/netdata/Team/Personal/congsheng/PI-DEX
PI_DEX_ARTIFACTS=/mnt/netdata/Team/Personal/congsheng/pi-dex-artifacts
CONDA_ROOT=/mnt/netdata/Team/Personal/congsheng/miniconda
PI_DEX_CONDA_ENV=pi-dex
OPENPI_DATA_HOME=/mnt/netdata/Team/Personal/congsheng/pi-dex-artifacts/openpi-data

CONTRACT=/mnt/netdata/Team/Personal/congsheng/PI-DEX/configs/site/joint_29d_observation.reviewed.json

# --- full OpenData ---
DATASET_ROOT=/mnt/netdata/Team/Academic/Data/North/SharpaOpenData
ASSETS_DIR=/mnt/netdata/Team/Personal/congsheng/pi-dex-artifacts/assets-opendata
ASSET_ID=sharpa_joint_29d_opendata_v0
ROBOT_ID=POC22027
SPLIT=train

# --- local dry-run MLP stubs (platform overrides these in real jobs) ---
MLP_WORKER_NUM=1
MLP_WORKER_GPU=1
MLP_ROLE_INDEX=0
MLP_WORKER_0_HOST=127.0.0.1
MLP_WORKER_0_PORT=29500
