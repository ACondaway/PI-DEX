# Volcano Engine MLP + PI-DEX joint_29d (Insert_Battery / 1×8 GPU, K=50, scheme-A delta).
# Training target: delta[k] = absolute_cmd[k] - state(t0).
# Layout v4: per-hand logical action is 36D = arm(7)+hand(22)+motor(7) duplicated on L/R.
# Model action_dim=36 (expanded from pi05_base 32D projections).
# Deployment must use --action-mode delta (robot bridge composes absolute before publish).
#
# MLP 自定义启动命令:
#   export WANDB_API_KEY=...
#   set -a; source /mnt/netdata/Team/Personal/congsheng/PI-DEX/configs/volc/joint_29d_insert_battery.k50.delta.8gpu.env; set +a
#   bash /mnt/netdata/Team/Personal/congsheng/PI-DEX/scripts/volc_ddp_train.sh
#
# Norm (single CPU process, before train):
#   set -a; source .../joint_29d_insert_battery.k50.delta.8gpu.env; set +a
#   VOLC_SKIP_MLP=1 bash .../scripts/volc_compute_norm.sh
#
# Local 2-GPU smoke:
#   set -a; source .../joint_29d_insert_battery.k50.delta.8gpu.env; set +a
#   export MLP_WORKER_NUM=1 MLP_WORKER_GPU=2 MLP_ROLE_INDEX=0
#   export MLP_WORKER_0_HOST=127.0.0.1 MLP_WORKER_0_PORT=29500 VOLC_WANDB=0
#   bash .../scripts/volc_ddp_train.sh

# --- site paths ---
PI_DEX_REPO=/mnt/netdata/Team/Personal/congsheng/PI-DEX
PI_DEX_ARTIFACTS=/mnt/netdata/Team/Personal/congsheng/pi-dex-artifacts
CONDA_ROOT=/mnt/netdata/Team/Personal/congsheng/miniconda
PI_DEX_CONDA_ENV=pi-dex
OPENPI_DATA_HOME=/mnt/netdata/Team/Personal/congsheng/pi-dex-artifacts/openpi-data

CONTRACT=/mnt/netdata/Team/Personal/congsheng/PI-DEX/configs/site/joint_29d_observation.k50.reviewed.json
CONVERTED_BASE=/mnt/netdata/Team/Personal/congsheng/pi-dex-artifacts/converted/pi05_base-pytorch-bfloat16-K8-m36
EXPECTED_BASE_SHA256=387f94e29a98a38a357080e9cd5acf09893b4c02bc3080f6ce757b7c1038f03a

# --- Insert_Battery prepared overlay ---
DATASET_ROOT=/mnt/netdata/Team/Personal/congsheng/pi-dex-artifacts/prepared/Insert_Battery
ASSETS_DIR=/mnt/netdata/Team/Personal/congsheng/pi-dex-artifacts/assets-Insert_Battery
ASSET_ID=sharpa_joint_29d_insert_battery_k50_delta_m36
ROBOT_ID=POC22005

# --- action semantics (HDF5 commands remain absolute; labels are delta) ---
ACTION_MODE=delta
COMMAND_SEMANTICS_VERSION=sharpa_sdk_commanded_joint_position_absolute_v1

# --- train hyperparams ---
MAX_STEPS=40000
BATCH_SIZE=16
LEARNING_RATE=1e-5
LR_WARMUP_STEPS=1000
LR_DECAY_STEPS=40000
LR_END=1e-6
SEED=0
DEVICE=cuda
DTYPE=bfloat16
SPLIT=train
SAVE_INTERVAL=5000
LOG_INTERVAL=10

# --- wandb ---
VOLC_WANDB=1
WANDB_PROJECT=pi-dex

# Norm job output (volc_compute_norm.sh)
OUTPUT_JSON=${PI_DEX_ARTIFACTS}/dataset/Insert_Battery_k50_delta_m36_norm.json
